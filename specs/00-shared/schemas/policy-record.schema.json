{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigri.local/schemas/policy-record.schema.json",
  "title": "Policy Record",
  "description": "Typed, clause-cited record compiled from an insurer's policy document. Product-level: the Client, assets and dates bind later on the Policy. Every field the compiler fills carries a clause reference; a field with no clause is listed in extraction.needs_review. The quarantined compiler may only produce JSON that validates against this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_record_id", "version", "status", "insurer", "product_name", "product_type", "insured_class", "period", "currency", "perils_covered", "exclusions", "sum_insured", "premium", "loss_categories", "deadlines", "documents_required", "extraction"],
  "properties": {
    "policy_record_id": { "type": "string", "pattern": "^PR-[A-Z]{3}-[A-Z0-9]{2,8}-[0-9]{4}$", "examples": ["PR-JSD-RFD-2026"] },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["compiling", "needs_review", "ready", "published", "retired", "held"] },
    "insurer": {
      "type": "object", "additionalProperties": false,
      "required": ["insurer_id", "code", "name"],
      "properties": {
        "insurer_id": { "type": "string" },
        "code": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "name": { "type": "string" }
      }
    },
    "product_name": { "$ref": "#/$defs/citedText" },
    "product_type": { "enum": ["crop_indemnity", "livestock_mortality"] },
    "scheme": {
      "description": "Present for government schemes (AUTP, AUTS/K).",
      "type": "object", "additionalProperties": false,
      "required": ["code", "subsidy_pct", "subsidy_payer"],
      "properties": {
        "code": { "type": "string", "examples": ["AUTP", "AUTS/K"] },
        "subsidy_pct": { "$ref": "#/$defs/pct" },
        "subsidy_payer": { "type": "string", "examples": ["Government of Indonesia"] },
        "clause": { "$ref": "#/$defs/clauseRef" }
      }
    },
    "insured_class": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "crop", "unit", "clause"],
          "properties": {
            "kind": { "const": "crop" },
            "crop": { "type": "string", "examples": ["rice", "corn"] },
            "varieties": { "type": "array", "items": { "type": "string" } },
            "land_types": { "type": "array", "items": { "type": "string" }, "examples": [["irrigated lowland", "rain-fed lowland"]] },
            "unit": { "const": "parcel" },
            "clause": { "$ref": "#/$defs/clauseRef" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "species", "unit", "identification", "clause"],
          "properties": {
            "kind": { "const": "livestock" },
            "species": { "type": "array", "minItems": 1, "items": { "enum": ["cattle", "buffalo", "goat", "swine", "poultry"] } },
            "unit": { "const": "head" },
            "identification": {
              "type": "object", "additionalProperties": false,
              "required": ["ear_tag"],
              "properties": {
                "ear_tag": { "const": "required_at_purchase" },
                "poultry": { "const": "batch_tag_per_flock_or_house" }
              }
            },
            "clause": { "$ref": "#/$defs/clauseRef" }
          }
        }
      ]
    },
    "eligibility": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule", "text", "clause"],
        "properties": {
          "rule": { "enum": ["max_area_ha", "min_area_ha", "member_of_farmer_group", "max_heads", "region_in"] },
          "value": {},
          "text": { "type": "string", "examples": ["For farmer-group members farming up to 2 ha."] },
          "clause": { "$ref": "#/$defs/clauseRef" }
        }
      }
    },
    "period": {
      "type": "object", "additionalProperties": false,
      "required": ["rule", "clause"],
      "properties": {
        "rule": { "enum": ["purchase_to_season_end", "planting_to_harvest", "fixed_12_months"] },
        "max_days": { "type": "integer", "minimum": 1 },
        "text": { "type": "string" },
        "clause": { "$ref": "#/$defs/clauseRef" }
      }
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "perils_covered": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["peril", "clause"],
        "properties": {
          "peril": { "enum": ["flood", "drought", "pest_disease", "typhoon_wind", "death_disease", "death_accident", "death_calving", "death_flood", "theft"] },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "value", "text"],
              "properties": {
                "kind": { "enum": ["min_inundation_days", "min_irrigation_failure_days", "min_wind_kmh"] },
                "value": { "type": "number" },
                "text": { "type": "string" }
              }
            }
          },
          "clause": { "$ref": "#/$defs/clauseRef" }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["exclusion", "clause"],
        "properties": {
          "exclusion": { "type": "string" },
          "clause": { "$ref": "#/$defs/clauseRef" }
        }
      }
    },
    "sum_insured": {
      "type": "object", "additionalProperties": false,
      "required": ["basis", "clause"],
      "properties": {
        "basis": { "enum": ["per_hectare", "per_head"] },
        "amount_minor": { "type": "integer", "minimum": 0, "description": "Per hectare or per head, in currency minor units." },
        "cap_minor": { "type": "integer", "minimum": 0, "description": "Cap per head when the value comes from the declared value." },
        "value_source": { "enum": ["fixed", "declared_value_per_head"] },
        "by_stage": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["stage", "pct"],
            "properties": {
              "stage": { "enum": ["establishment", "vegetative", "reproductive", "maturity"] },
              "until_days_after_planting": { "type": "integer", "minimum": 0 },
              "pct": { "$ref": "#/$defs/pct" }
            }
          }
        },
        "clause": { "$ref": "#/$defs/clauseRef" }
      }
    },
    "deductible": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "pct", "applies", "clause"],
      "properties": {
        "kind": { "enum": ["franchise", "deductible"], "description": "franchise: losses below pct pay nothing, at or above pay in full. deductible: pct is subtracted (decision D-07)." },
        "pct": { "$ref": "#/$defs/pct" },
        "applies": { "enum": ["per_asset", "per_policy"] },
        "clause": { "$ref": "#/$defs/clauseRef" }
      }
    },
    "premium": {
      "type": "object", "additionalProperties": false,
      "required": ["rate_pct_of_sum_insured", "clause"],
      "properties": {
        "rate_pct_of_sum_insured": { "$ref": "#/$defs/pct" },
        "per": { "enum": ["season", "year"] },
        "clause": { "$ref": "#/$defs/clauseRef" }
      }
    },
    "loss_categories": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["category", "pays", "clause"],
        "properties": {
          "category": { "enum": ["total", "partial", "no_loss"] },
          "min_loss_pct": { "$ref": "#/$defs/pct" },
          "max_loss_pct": { "$ref": "#/$defs/pct", "description": "Exclusive upper bound." },
          "pays": { "enum": ["full_sum_insured", "assessed_pct_of_sum_insured", "nothing"] },
          "clause": { "$ref": "#/$defs/clauseRef" }
        }
      }
    },
    "deadlines": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["event", "days", "from", "day_kind", "text", "source"],
        "properties": {
          "event": { "enum": ["notice_of_loss", "claim_documents", "settlement", "appeal"] },
          "days": { "type": "integer", "minimum": 0 },
          "from": { "enum": ["loss_event_start", "loss_event_end", "notice", "complete_claim", "decision"] },
          "day_kind": { "enum": ["calendar", "business"] },
          "text": { "type": "string", "examples": ["Report a loss within 7 days after the event ends"] },
          "source": { "enum": ["document", "insurer_entered"], "description": "insurer_entered when the document states none (decision D-17)." },
          "clause": { "$ref": "#/$defs/clauseRef" }
        }
      }
    },
    "documents_required": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["doc", "clause"],
        "properties": {
          "doc": { "type": "string" },
          "required": { "type": "boolean", "default": true },
          "clause": { "$ref": "#/$defs/clauseRef" }
        }
      }
    },
    "issuance_limits": {
      "description": "Set by the Product Manager, never compiled from the document.",
      "type": "object", "additionalProperties": false,
      "required": ["regions", "above_limits", "set_by", "set_at"],
      "properties": {
        "auto_issue_max_area_ha": { "type": "number", "minimum": 0 },
        "auto_issue_max_heads": { "type": "integer", "minimum": 0 },
        "max_sum_insured_minor": { "type": "integer", "minimum": 0 },
        "max_exposure_per_regency_minor": { "type": "integer", "minimum": 0 },
        "regions": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Pack region codes (regencies)." },
        "sale_window": {
          "type": "object", "additionalProperties": false,
          "required": ["start", "end"],
          "properties": { "start": { "type": "string", "format": "date" }, "end": { "type": "string", "format": "date" } }
        },
        "above_limits": { "enum": ["send_to_underwriting", "refuse"] },
        "set_by": { "type": "string" },
        "set_at": { "type": "string", "format": "date-time" }
      }
    },
    "extraction": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "confidence", "needs_review", "self_check", "injection_findings"],
      "properties": {
        "model": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "needs_review": { "type": "array", "items": { "type": "string", "description": "JSON pointer of the field." } },
        "self_check": {
          "type": "object", "additionalProperties": false,
          "required": ["questions", "disagreements"],
          "properties": {
            "questions": { "type": "integer", "minimum": 0 },
            "disagreements": { "type": "integer", "minimum": 0 }
          }
        },
        "injection_findings": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "pct": { "type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,4})?$", "description": "Percent as a decimal string, never a float (hashing rules)." },
    "clauseRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "examples": ["4.1", "Scheme rule 2.1"] },
        "page": { "type": "integer", "minimum": 1 },
        "span": { "type": "array", "prefixItems": [{ "type": "integer" }, { "type": "integer" }], "minItems": 2, "maxItems": 2, "description": "Character offsets in the extracted page text." }
      }
    },
    "citedText": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "clause"],
      "properties": { "value": { "type": "string" }, "clause": { "$ref": "#/$defs/clauseRef" } }
    }
  }
}
