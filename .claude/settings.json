{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(make lint:*)",
      "Bash(make test:*)",
      "Bash(make e2e:*)",
      "Bash(make bench:*)",
      "Bash(make openapi:*)",
      "Bash(make seed:*)",
      "Bash(make demo-reset:*)",
      "Bash(make up:*)",
      "Bash(make -C:*)",
      "Bash(uv:*)",
      "Bash(pnpm:*)",
      "Bash(alembic:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list:*)",
      "Bash(git -C:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(git fetch:*)",
      "Bash(git push origin lane/a:*)",
      "Bash(git push -u origin lane/a:*)",
      "Bash(git push origin lane/b:*)",
      "Bash(git push -u origin lane/b:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin +*)",
      "Edit(.specify/memory/constitution.md)",
      "Edit(DESIGN.md)",
      "Edit(docs/source/**)",
      "Edit(system-preview/**)",
      "Edit(design-system/**)",
      "Edit(wireframe/**)",
      "Edit(brand/**)",
      "Edit(landing-preview/**)"
    ]
  }
}
