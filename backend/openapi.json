                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Packs",
        "tags": [
          "packs"
        ]
      }
    },
    "/api/v1/packs/{code}": {
      "get": {
        "operationId": "get_pack_api_v1_packs__code__get",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "title": "Code",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pack"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Pack",
        "tags": [
          "packs"
        ]
      }
