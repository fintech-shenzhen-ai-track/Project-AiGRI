# Copy to .env. Every key the stack reads is listed here. No real secrets: these are sandbox values.

# --- Database ------------------------------------------------------------------------------
POSTGRES_DB=aigri
# Owner role: used by Alembic only. In the sandbox it is also the Postgres bootstrap superuser.
POSTGRES_USER=aigri_owner
POSTGRES_PASSWORD=aigri_owner
# App role (created by migration 0001): used by the API and worker. Not a table owner, no BYPASSRLS.
AIGRI_APP_PASSWORD=aigri_app
DATABASE_URL=postgresql+asyncpg://aigri_app:aigri_app@db:5432/aigri
DATABASE_OWNER_URL=postgresql+asyncpg://aigri_owner:aigri_owner@db:5432/aigri

# --- Platform ------------------------------------------------------------------------------
# true in the sandbox: enables demo accounts, the story clock and /dev endpoints. Must be false elsewhere.
SANDBOX=true
# real | demo
CLOCK_MODE=real
DEFAULT_PACK=ID
# At least 16 characters. Replace outside the sandbox.
SESSION_SECRET=change-me-sandbox-session-secret
# Token for demo scripts calling /api/v1/dev/* (sandbox only).
DEV_TOKEN=change-me-sandbox-dev-token

# --- Object storage (MinIO) ----------------------------------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=aigri
MINIO_SECRET_KEY=aigri-minio-secret
MINIO_BUCKET=aigri-evidence

# --- Mock services and worker --------------------------------------------------------------
MOCK_SMS_URL=http://mock-sms:8000
MOCK_EMAIL_URL=http://mock-email:8000
MOCK_WALLET_URL=http://mock-wallet:8000
WORKER_URL=http://worker:8001

# --- Language model (Ollama) ---------------------------------------------------------------
# qwen3:14b needs about 9,3 GB to download. On small machines set LLM_MODEL=qwen3:8b.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3:14b
LLM_VISION_MODEL=qwen3-vl:8b
# Optional hosted fallback (leave empty to disable)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# --- Web Push (VAPID) ----------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Thresholds ----------------------------------------------------------------------------
PHASH_MAX_DISTANCE=8
CURATION_THETA=0.50

# --- Portals -------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
